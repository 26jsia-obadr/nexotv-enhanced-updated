{
  "name": "nexotv-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "test": "pnpm --filter backend test",
    "typecheck": "pnpm --filter frontend typecheck && pnpm --filter backend typecheck",
    "check": "pnpm typecheck && pnpm test",
    "start": "pnpm --filter backend start"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
